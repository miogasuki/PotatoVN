<Page
    x:Class="GalgameManager.Views.PluginStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    x:Name="Page"
    mc:Ignorable="d">

    <Page.Resources>
        <converter:DateTimeToStringConverter x:Key="DateTimeToStringConverter" />
        <converter:ImagePathConverter x:Key="ImagePathConverter" />
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Plugins}" Margin="20">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:StorePlugin">
                        <Button Style="{ThemeResource TransparentButtonWithHover}"
                                DataContext="{x:Bind}"
                                Command="{Binding ElementName=Page, Path=ViewModel.ItemClickCommand}"
                                CommandParameter="{x:Bind}">
                            <Grid Width="300" Height="120" ColumnSpacing="20" Margin="20 10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Logo -->
                                <Grid Grid.Column="0" CornerRadius="10" Width="80" Height="80" VerticalAlignment="Center">
                                    <Image Source="{x:Bind Logo, Mode=OneWay, Converter={StaticResource ImagePathConverter}}"
                                           Stretch="UniformToFill">
                                    </Image>
                                </Grid>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title -->
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                               Style="{ThemeResource SubtitleTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Text="{x:Bind DescriptionShort, Mode=OneWay}"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <!-- Release Date -->
                                    <TextBlock Grid.Row="2" Text="{x:Bind ReleaseDate, Mode=OneWay, Converter={StaticResource DateTimeToStringConverter}}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               HorizontalAlignment="Left"/>
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="300" ItemsStretch="Fill"
                                       MinRowSpacing="10" MinColumnSpacing="10"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
