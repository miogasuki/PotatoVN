
<ContentDialog
    x:Class="GalgameManager.Views.Dialog.GlobalKeyMappingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d"
    x:Name="dialog"
    Title="全局按键映射设置"
    PrimaryButtonText="保存"
    SecondaryButtonText="清空"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ContentDialog.Resources>

    <StackPanel Spacing="10">
        <!-- 使用DataGrid实现表格布局 -->
        <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4"
                Visibility="{x:Bind HasMappings, Mode=OneWay}">
            <controls:DataGrid x:Name="MappingsDataGrid"
                      ItemsSource="{x:Bind Mappings, Mode=OneWay}"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#FFE0E0E0"
                      VerticalGridLinesBrush="Transparent"
                      HeadersVisibility="Column"
                      MaxHeight="400"
                      MinHeight="200"
                      VerticalScrollBarVisibility="Auto"
                      Background="White"
                      HorizontalAlignment="Stretch"
                      MinWidth="500"
                      BorderThickness="0"
                      Padding="0">

                <controls:DataGrid.Columns>
                    <!-- 说明列 -->
                    <controls:DataGridTemplateColumn Header="说明" Width="2*" CanUserResize="True">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:KeyMapping">
                                <TextBox Text="{x:Bind Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       VerticalAlignment="Center"
                                       BorderThickness="1"
                                       Margin="5"
                                       BorderBrush="{ThemeResource TextControlBorderBrush}"
                                       Background="{ThemeResource TextControlBackground}"/>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!-- 设置按键列 -->
                    <controls:DataGridTemplateColumn Header="设置按键" Width="*" CanUserResize="False">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:KeyMapping">
                                <control:FlexibleHotkeyInputBox HotkeyKeys="{x:Bind From, Mode=TwoWay}"
                                                               Margin="5"/>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!-- 开关列 -->
                    <controls:DataGridTemplateColumn Header="开关" Width="Auto" CanUserResize="False" MinWidth="60">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:KeyMapping">
                                <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="5,2"
                                            MinWidth="0"/>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!-- 删除列 -->
                    <controls:DataGridTemplateColumn Header="删除" Width="Auto" CanUserResize="False" MinWidth="50">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:KeyMapping">
                                <Button Click="DeleteButton_Click"
                                      Tag="{x:Bind}"
                                      VerticalAlignment="Center"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HorizontalAlignment="Center"
                                      Padding="3"
                                      Width="30" Height="30">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="14"/>
                                </Button>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>

        <TextBlock Text="暂无按键映射" HorizontalAlignment="Center" Margin="0,10,0,0"
                   Visibility="{x:Bind HasMappings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />

        <Button Command="{x:Bind AddMappingCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Add" />
                <TextBlock Text="添加新映射" />
            </StackPanel>
        </Button>
    </StackPanel>
</ContentDialog>
