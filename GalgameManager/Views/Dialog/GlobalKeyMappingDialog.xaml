
<ContentDialog
    x:Class="GalgameManager.Views.Dialog.GlobalKeyMappingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    mc:Ignorable="d"
    x:Name="dialog"
    Title="{x:Uid GlobalKeyMappingDialog_Title}"
    PrimaryButtonText="{x:Uid GlobalKeyMappingDialog_Button_Save}"
    SecondaryButtonText="{x:Uid GlobalKeyMappingDialog_Button_Clear}"
    CloseButtonText="{x:Uid GlobalKeyMappingDialog_Button_Cancel}"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ContentDialog.Resources>

    <StackPanel Spacing="10">
        <!-- 表格容器 -->
        <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Background="White"
                Visibility="{x:Bind HasMappings, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Border Grid.Row="0" Background="#FFF8F8F8" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="200" />
                            <ColumnDefinition Width="*" MinWidth="150" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Uid KeyMappingDialog_Header_Description}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Margin="10,8" />
                        <TextBlock Grid.Column="1" Text="{x:Uid KeyMappingDialog_Header_FromKey}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="{x:Uid KeyMappingDialog_Header_Enabled}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="{x:Uid KeyMappingDialog_Header_Delete}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <!-- 数据行容器 -->
                <ScrollViewer Grid.Row="1" MaxHeight="400" MinHeight="200" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind Mappings, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:KeyMapping">
                                <Border BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="200" />
                                            <ColumnDefinition Width="*" MinWidth="150" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 说明列 -->
                                        <TextBox Grid.Column="0" Text="{x:Bind Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{x:Uid KeyMappingDialog_Placeholder_Description}"
                                                 VerticalAlignment="Center" MinWidth="150" BorderThickness="1"
                                                 Margin="5"
                                                 BorderBrush="{ThemeResource TextControlBorderBrush}"
                                                 Background="{ThemeResource TextControlBackground}"/>

                                        <!-- 设置按键列 -->
                                        <control:FlexibleHotkeyInputBox Grid.Column="1"
                                                                       HotkeyKeys="{x:Bind From, Mode=TwoWay}"
                                                                       Margin="5"/>

                                        <!-- 开关列 -->
                                        <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="5,2"
                                                    MinWidth="0"/>

                                        <!-- 删除列 -->
                                        <Button Grid.Column="3" Click="DeleteButton_Click"
                                              Tag="{x:Bind}"
                                              VerticalAlignment="Center"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              HorizontalAlignment="Center"
                                              Padding="3"
                                              Width="30" Height="30">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="14"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Text="{x:Uid GlobalKeyMappingDialog_Text_NoMappings}" HorizontalAlignment="Center" Margin="0,10,0,0"
                   Visibility="{x:Bind HasMappings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />

        <Button Command="{x:Bind AddMappingCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Add" />
                <TextBlock Text="{x:Uid KeyMappingDialog_Button_AddMapping}" />
            </StackPanel>
        </Button>
    </StackPanel>
</ContentDialog>
