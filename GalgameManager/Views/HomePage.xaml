<Page
    x:Class="GalgameManager.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:converters="using:GalgameManager.Helpers.Converter"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:filters="using:GalgameManager.Models.Filters"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:prefab="using:GalgameManager.Views.Prefab"
    xmlns:cmtkControl="using:CommunityToolkit.WinUI.Controls"
    xmlns:cmtk="using:CommunityToolkit.WinUI"
    xmlns:cmtkAnimations="using:CommunityToolkit.WinUI.Animations"
    mc:Ignorable="d"
    x:Name="Page"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <MenuFlyout x:Name="GalFlyout" Opening="{x:Bind ViewModel.GalFlyout_Opening}">
            <!-- 游玩状态管理 -->
            <MenuFlyoutSubItem x:Uid="LibraryPage_PlayStatusSubMenu">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons"
                            Glyph="&#xE74C;"/>
                </MenuFlyoutSubItem.Icon>
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusPlaying"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}" 
                                     CommandParameter="Playing"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'Playing'), Mode=OneWay}"
                                     GroupName="PlayStatus"/>
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusPlayed"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}" 
                                     CommandParameter="Played"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'Played'), Mode=OneWay}"
                                     GroupName="PlayStatus"/>
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusOnHold"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}" 
                                     CommandParameter="Shelved"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'Shelved'), Mode=OneWay}"
                                     GroupName="PlayStatus"/>
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusAbandoned"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}" 
                                     CommandParameter="Abandoned"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'Abandoned'), Mode=OneWay}"
                                     GroupName="PlayStatus"/>
                <RadioMenuFlyoutItem x:Uid="LibraryPage_PlayStatusWantToPlay"
                                     Command="{x:Bind ViewModel.GalFlyOutChangePlayStatusCommand}" 
                                     CommandParameter="WantToPlay"
                                     IsChecked="{x:Bind ViewModel.IsCurrentPlayType(ViewModel.CurrentContextGame, 'WantToPlay'), Mode=OneWay}"
                                     GroupName="PlayStatus"/>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="LibraryPage_PlayStatusMoreSettings"
                        Command="{x:Bind ViewModel.ShowChangePlayStatusDialogCommand}" CommandParameter="{Binding}" />
            </MenuFlyoutSubItem>
            <!-- 编辑游戏信息 -->
            <MenuFlyoutItem Icon="Edit" x:Uid="LibraryPage_Edit" Command="{x:Bind ViewModel.GalFlyOutEditCommand}" CommandParameter="{Binding}"/>
            <!-- 下载游戏信息 -->
            <MenuFlyoutItem Icon="Download" x:Uid="LibraryPage_Download" Command="{x:Bind ViewModel.GalFlyOutGetInfoFromRssCommand}" CommandParameter="{Binding}"/>
            <!-- 在文件管理器中打开 -->
            <MenuFlyoutItem Icon="OpenLocal" x:Uid="LibraryPage_OpenGameInExplorer"
                           Command="{x:Bind ViewModel.OpenGameInExplorerCommand}"
                           IsEnabled="{x:Bind ViewModel.CurrentContextGame.IsLocalGame, Mode=OneWay}"
                           CommandParameter="{Binding}"/>
            <!-- 删除游戏 -->
            <MenuFlyoutItem Icon="Delete" x:Uid="LibraryPage_Remove" Command="{x:Bind ViewModel.GalFlyOutDeleteCommand}" CommandParameter="{Binding}"/>
        </MenuFlyout>
    </Page.Resources>

    <Grid AllowDrop="True" Drop="{x:Bind ViewModel.Grid_Drop}"
          DragEnter="{x:Bind ViewModel.Grid_DragEnter}" DragLeave="{x:Bind ViewModel.Grid_DragLeave}"
          Margin="0 0 0 20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <CommandBar Grid.Row="0" Background="Transparent" IsOpen="False" DefaultLabelPosition="Right"
                        Margin="{StaticResource CommandBarMargin}">
                <!-- 搜索 -->
                <AppBarButton Icon="Find" Label="{x:Bind ViewModel.SearchTitle, Mode=OneWay}" AllowFocusOnInteraction="True">
                    <AppBarButton.Flyout>
                        <Flyout Placement="Bottom">
                            <control:SearchAutoSuggestBox SearchCommand="{x:Bind ViewModel.SearchCommand}" 
                                                          SearchKey="{x:Bind ViewModel.SearchKey, Mode=TwoWay}"
                                                          SearchSuggestionsProvider="{x:Bind ViewModel.GalgameSearchSuggestionsProvider}"/>
                        </Flyout>
                    </AppBarButton.Flyout>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="F" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <!-- 过滤 -->
                <AppBarButton x:Uid="HomePage_Filter" Label="{x:Bind ViewModel.UiFilter, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71C;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <Flyout Placement="Bottom">
                            <cmtkControl:TokenizingTextBox 
                                x:Uid="HomePage_FilterTokenizingTextBox"
                                Width="250" HorizontalAlignment="Left"
                                TokenDelimiter=","
                                ItemsSource="{x:Bind ViewModel.Filters, Mode=TwoWay}"
                                QueryIcon="{cmtk:FontIconSource Glyph=&#xE721;,
                                                                  FontSize=12}"
                                SuggestedItemsSource="{x:Bind ViewModel.FilterInputSuggestions, Mode=OneWay}"
                                AllowFocusOnInteraction="True"
                                Text="{x:Bind ViewModel.FilterInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <cmtkControl:TokenizingTextBox.AutoSuggestBoxStyle>
                                    <Style TargetType="AutoSuggestBox">
                                        <Setter Property="MinWidth" Value="200"/>
                                    </Style>
                                </cmtkControl:TokenizingTextBox.AutoSuggestBoxStyle>
                                <cmtkControl:TokenizingTextBox.SuggestedItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding }" />
                                    </DataTemplate>
                                </cmtkControl:TokenizingTextBox.SuggestedItemTemplate>
                                <cmtkControl:TokenizingTextBox.TokenItemTemplate>
                                    <DataTemplate x:DataType="filters:FilterBase">
                                        <TextBlock Text="{x:Bind ToString() }" />
                                    </DataTemplate>
                                </cmtkControl:TokenizingTextBox.TokenItemTemplate>
                                <interactivity:Interaction.Behaviors>
                                    <core:EventTriggerBehavior EventName="TokenItemRemoved">
                                        <core:InvokeCommandAction Command="{x:Bind ViewModel.FilterRemovedCommand}" />
                                    </core:EventTriggerBehavior>
                                    <core:EventTriggerBehavior EventName="TextChanged">
                                        <core:InvokeCommandAction Command="{x:Bind ViewModel.FilterInputTextChangeCommand}" />
                                    </core:EventTriggerBehavior>
                                    <core:EventTriggerBehavior EventName="TokenItemAdding">
                                        <core:InvokeCommandAction Command="{x:Bind ViewModel.FilterInputTokenItemAddingCommand}" />
                                    </core:EventTriggerBehavior>
                                    <core:EventTriggerBehavior EventName="TokenItemAdding">
                                        <core:InvokeCommandAction Command="{x:Bind ViewModel.FilterInputTokenItemAddingCommand}" />
                                    </core:EventTriggerBehavior>
                                </interactivity:Interaction.Behaviors>
                            </cmtkControl:TokenizingTextBox>
                            
                            <interactivity:Interaction.Behaviors>
                                <core:EventTriggerBehavior EventName="Opening">
                                    <core:InvokeCommandAction Command="{x:Bind ViewModel.FilterFlyoutOpeningCommand}" />
                                </core:EventTriggerBehavior>
                            </interactivity:Interaction.Behaviors>
                        </Flyout>
                    </AppBarButton.Flyout>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="K"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <!-- 添加游戏 -->
                <AppBarButton
                    Icon="Add"
                    x:Uid="HomePage_AddNewGame"
                    Command="{x:Bind ViewModel.AddGalgameCommand}"
                    IsEnabled="{x:Bind ViewModel.IsPhrasing, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <!-- 排序 -->
                <AppBarButton x:Uid="HomePage_Sort" Icon="Sort">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <!-- 第一排序键 -->
                            <MenuFlyoutSubItem x:Uid="HomePage_Sort_FirstKey">
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_Name" 
                                               Command="{x:Bind ViewModel.SetPrimaryKeyCommand}" 
                                               CommandParameter="Name"
                                               GroupName="PrimarySorting"
                                               IsChecked="{x:Bind ViewModel.IsPrimaryKey('Name'), Mode=OneWay}"/>
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_Developer" 
                                               Command="{x:Bind ViewModel.SetPrimaryKeyCommand}" 
                                               CommandParameter="Developer"
                                               GroupName="PrimarySorting"
                                               IsChecked="{x:Bind ViewModel.IsPrimaryKey('Developer'), Mode=OneWay}"/>
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_Rating" 
                                               Command="{x:Bind ViewModel.SetPrimaryKeyCommand}" 
                                               CommandParameter="Rating"
                                               GroupName="PrimarySorting"
                                               IsChecked="{x:Bind ViewModel.IsPrimaryKey('Rating'), Mode=OneWay}"/>
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_LastPlay" 
                                               Command="{x:Bind ViewModel.SetPrimaryKeyCommand}" 
                                               CommandParameter="LastPlay"
                                               GroupName="PrimarySorting"
                                               IsChecked="{x:Bind ViewModel.IsPrimaryKey('LastPlay'), Mode=OneWay}"/>
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_ReleaseDate" 
                                               Command="{x:Bind ViewModel.SetPrimaryKeyCommand}" 
                                               CommandParameter="ReleaseDate"
                                               GroupName="PrimarySorting"
                                               IsChecked="{x:Bind ViewModel.IsPrimaryKey('ReleaseDate'), Mode=OneWay}"/>
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_LastFetchInfoTime" 
                                               Command="{x:Bind ViewModel.SetPrimaryKeyCommand}" 
                                               CommandParameter="LastFetchInfoTime"
                                               GroupName="PrimarySorting"
                                               IsChecked="{x:Bind ViewModel.IsPrimaryKey('LastFetchInfoTime'), Mode=OneWay}"/>
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_AddTime" 
                                               Command="{x:Bind ViewModel.SetPrimaryKeyCommand}" 
                                               CommandParameter="AddTime"
                                               GroupName="PrimarySorting"
                                               IsChecked="{x:Bind ViewModel.IsPrimaryKey('AddTime'), Mode=OneWay}"/>
                                <MenuFlyoutSeparator/>
                                <ToggleMenuFlyoutItem x:Uid="HomePage_Sort_PrimaryDescending"
                                                 IsChecked="{x:Bind ViewModel.IsPrimaryDescending, Mode=TwoWay}"
                                                 Command="{x:Bind ViewModel.ApplySortCommand}"/>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator/>
                            <!-- 第二排序键 -->
                            <MenuFlyoutSubItem x:Uid="HomePage_Sort_SecondKey">
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_Name" 
                                               Command="{x:Bind ViewModel.SetSecondaryKeyCommand}" 
                                               CommandParameter="Name"
                                               GroupName="SecondarySorting"
                                               IsChecked="{x:Bind ViewModel.IsSecondaryKey('Name'), Mode=OneWay}"/>
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_Developer" 
                                               Command="{x:Bind ViewModel.SetSecondaryKeyCommand}" 
                                               CommandParameter="Developer"
                                               GroupName="SecondarySorting"
                                               IsChecked="{x:Bind ViewModel.IsSecondaryKey('Developer'), Mode=OneWay}"/>
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_Rating" 
                                               Command="{x:Bind ViewModel.SetSecondaryKeyCommand}" 
                                               CommandParameter="Rating"
                                               GroupName="SecondarySorting"
                                               IsChecked="{x:Bind ViewModel.IsSecondaryKey('Rating'), Mode=OneWay}"/>
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_LastPlay" 
                                               Command="{x:Bind ViewModel.SetSecondaryKeyCommand}" 
                                               CommandParameter="LastPlay"
                                               GroupName="SecondarySorting"
                                               IsChecked="{x:Bind ViewModel.IsSecondaryKey('LastPlay'), Mode=OneWay}"/>
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_ReleaseDate" 
                                               Command="{x:Bind ViewModel.SetSecondaryKeyCommand}" 
                                               CommandParameter="ReleaseDate"
                                               GroupName="SecondarySorting"
                                               IsChecked="{x:Bind ViewModel.IsSecondaryKey('ReleaseDate'), Mode=OneWay}"/>
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_LastFetchInfoTime" 
                                               Command="{x:Bind ViewModel.SetSecondaryKeyCommand}" 
                                               CommandParameter="LastFetchInfoTime"
                                               GroupName="SecondarySorting"
                                               IsChecked="{x:Bind ViewModel.IsSecondaryKey('LastFetchInfoTime'), Mode=OneWay}"/>
                                <RadioMenuFlyoutItem x:Uid="HomePage_Sort_AddTime" 
                                               Command="{x:Bind ViewModel.SetSecondaryKeyCommand}" 
                                               CommandParameter="AddTime"
                                               GroupName="SecondarySorting"
                                               IsChecked="{x:Bind ViewModel.IsSecondaryKey('AddTime'), Mode=OneWay}"/>
                                <MenuFlyoutSeparator/>
                                <ToggleMenuFlyoutItem x:Uid="HomePage_Sort_SecondaryDescending"
                                                 IsChecked="{x:Bind ViewModel.IsSecondaryDescending, Mode=TwoWay}"
                                                 Command="{x:Bind ViewModel.ApplySortCommand}"/>
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <!-- 裁剪横图 -->
                    <AppBarToggleButton x:Uid="HomePage_FixHorizontalPicture" Icon="Crop"
                                        IsChecked="{x:Bind ViewModel.FixHorizontalPicture, Mode=TwoWay}"/>
                    <!-- 游玩状态标记 -->
                    <AppBarToggleButton x:Uid="HomePage_DisplayPlayType" 
                                        IsChecked="{x:Bind ViewModel.DisplayPlayTypePolygon, Mode=TwoWay}"
                                        Visibility="{x:Bind ViewModel.FixHorizontalPicture, Mode=OneWay}">
                        <AppBarToggleButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE890;"/>
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <!-- 非本地游戏特殊显示 -->
                    <AppBarToggleButton x:Uid="HomePage_SpecialDisplayVirtualGame"
                                        IsChecked="{x:Bind ViewModel.SpecialDisplayVirtualGame, Mode=TwoWay}">
                        <AppBarToggleButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FF;"/>
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <!-- 保留过滤器 -->
                    <AppBarToggleButton x:Uid="HomePage_KeepFilters"
                                        IsChecked="{x:Bind ViewModel.KeepFilters, Mode=TwoWay}"
                                        Icon="{cmtk:FontIcon Glyph=&#xE840;}">
                    </AppBarToggleButton>
                    <!-- 显示非本地游戏 -->
                    <AppBarToggleButton x:Uid="HomePage_Filter_DisplayVirtualGames"
                                        IsChecked="{x:Bind ViewModel.DisplayVirtualGame, Mode=TwoWay}">
                        <AppBarToggleButton.Icon>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71C;"/>
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
            
            <ScrollViewer Grid.Row="1">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Source, Mode=OneWay}"
                               cmtkAnimations:Connected.ListItemKey="galgameItem"
                               cmtkAnimations:Connected.ListItemElementName="ConnectedElement">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:Galgame">
                            <Button Style="{ThemeResource TransparentButtonWithHover}"
                                    DataContext="{x:Bind}"
                                    Command="{Binding ElementName=Page, Path=ViewModel.ItemClickCommand}"
                                    CommandParameter="{x:Bind}">
                                <prefab:GalgamePrefab
                                    Galgame="{x:Bind}"
                                    ImageStretch="{Binding ElementName=Page, Path=ViewModel.Stretch, Mode=OneWay}"
                                    PlayTypeVisibility="{Binding ElementName=Page, Path=ViewModel.DisplayPlayTypePolygon, Mode=OneWay}"
                                    Flyout="{StaticResource GalFlyout}" />
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="Fill" MinItemWidth="175" MinRowSpacing="1" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Drag&Drop(用于提示的区域) -->
            <Border Grid.Row="1" CornerRadius="5" 
                    Background="{ThemeResource AccentAcrylicBackgroundFillColorBaseBrush}" 
                    Visibility="{x:Bind ViewModel.DisplayDragArea, Mode=OneWay}"
                    Opacity="0.6">
                <TextBlock x:Uid="HomePage_DragDrop" Style="{ThemeResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Grid
            Row="0"
            Background="#00000000"
            Visibility="{x:Bind ViewModel.IsPhrasing, Mode=OneWay}">
            <ProgressRing
                IsActive="True"
                Width="100"
                Height="100"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>