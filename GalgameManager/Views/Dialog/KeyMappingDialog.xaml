<ContentDialog
    x:Class="GalgameManager.Views.Dialog.KeyMappingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    mc:Ignorable="d"
    x:Name="dialog"
    Title="按键映射设置"
    PrimaryButtonText="关闭"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <converter:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ContentDialog.Resources>

    <StackPanel Spacing="10">
        <!-- 表格容器 -->
        <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Border Grid.Row="0" Background="#FFF8F8F8" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="说明" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Margin="10,8" />
                        <TextBlock Grid.Column="1" Text="设置按键" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="游戏中按键" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="开关" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="删除" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <!-- 数据行容器 -->
                <ScrollViewer Grid.Row="1" MaxHeight="400" MinHeight="200" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.KeyMappings, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:KeyMapping">
                                <Border BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 说明列 -->
                                        <Grid Grid.Column="0">
                                            <!-- 全局快捷键的红色角标 -->
                                            <Path Data="M 0,0 L 20,0 L 0,20 Z"
                                                  Fill="#FF0000"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  Visibility="{x:Bind IsGlobal, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBox Text="{x:Bind Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   IsEnabled="{x:Bind IsGlobal, Converter={StaticResource InverseBooleanConverter}}"
                                                   VerticalAlignment="Center" MinWidth="120" BorderThickness="1"
                                                   Margin="5"
                                                   BorderBrush="{ThemeResource TextControlBorderBrush}"
                                                   Background="{ThemeResource TextControlBackground}"/>
                                        </Grid>

                                        <!-- 设置按键列 -->
                                        <control:FlexibleHotkeyInputBox Grid.Column="1"
                                                                       HotkeyKeys="{x:Bind From, Mode=TwoWay}"
                                                                       IsEnabled="{x:Bind IsGlobal, Converter={StaticResource InverseBooleanConverter}}"
                                                                       Margin="5"/>

                                        <!-- 游戏中按键列 -->
                                        <control:FlexibleHotkeyInputBox Grid.Column="2"
                                                                       HotkeyKeys="{x:Bind To, Mode=TwoWay}"
                                                                       Margin="5"/>

                                        <!-- 开关列 -->
                                        <ToggleSwitch Grid.Column="3" IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="5,2"
                                                    MinWidth="0"/>

                                        <!-- 删除列 -->
                                        <Button Grid.Column="4" Click="DeleteButton_Click"
                                              Tag="{x:Bind}"
                                              VerticalAlignment="Center"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              HorizontalAlignment="Center"
                                              Padding="3"
                                              Width="30" Height="30"
                                              IsEnabled="{x:Bind IsGlobal, Converter={StaticResource InverseBooleanConverter}}">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="14"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Button Command="{x:Bind ViewModel.AddKeyMappingCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Add"/>
                <TextBlock x:Uid="GalgameSettingPage_AddKeyMapping" Text="添加新映射"/>
            </StackPanel>
        </Button>
    </StackPanel>
</ContentDialog>