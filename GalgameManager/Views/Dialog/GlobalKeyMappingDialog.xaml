
<ContentDialog
    x:Class="GalgameManager.Views.Dialog.GlobalKeyMappingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:control="using:GalgameManager.Views.Control"
    xmlns:converter="using:GalgameManager.Helpers.Converter"
    mc:Ignorable="d"
    x:Name="dialog"
    Title="全局按键映射设置"
    PrimaryButtonText="保存"
    SecondaryButtonText="清空"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ContentDialog.Resources>

    <StackPanel Spacing="10">
        <!-- 使用ItemsControl实现真正的表格布局 -->
        <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="4"
                Visibility="{x:Bind HasMappings, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Grid Grid.Row="0" Background="#FFF5F5F5" Padding="10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" /> <!-- Remark -->
                        <ColumnDefinition Width="*" /> <!-- From -->
                        <ColumnDefinition Width="Auto" MinWidth="80"/> <!-- IsEnabled -->
                        <ColumnDefinition Width="Auto" MinWidth="60"/> <!-- Delete -->
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="说明" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="设置按键" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="开关" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="删除" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>

                <!-- 表内容 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                    <ItemsControl ItemsSource="{x:Bind Mappings, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:KeyMapping">
                                <Border BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" /> <!-- Remark -->
                                            <ColumnDefinition Width="*" /> <!-- From -->
                                            <ColumnDefinition Width="Auto" MinWidth="80"/> <!-- IsEnabled -->
                                            <ColumnDefinition Width="Auto" MinWidth="60"/> <!-- Delete -->
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                               Text="{x:Bind Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               VerticalAlignment="Center"
                                               BorderThickness="1"/>
                                        <control:FlexibleHotkeyInputBox Grid.Column="1"
                                                                     HotkeyKeys="{x:Bind From, Mode=TwoWay}"
                                                                     Margin="5,0,0,0"/>
                                        <ToggleSwitch Grid.Column="2"
                                                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0"
                                                    HorizontalAlignment="Center"/>
                                        <Button Grid.Column="3"
                                              Command="{Binding RemoveMappingCommand, ElementName=dialog}"
                                              CommandParameter="{x:Bind}"
                                              VerticalAlignment="Center"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Margin="10,0,0,0"
                                              HorizontalAlignment="Center">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Text="暂无按键映射" HorizontalAlignment="Center" Margin="0,10,0,0"
                   Visibility="{x:Bind HasMappings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />

        <Button Command="{x:Bind AddMappingCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <SymbolIcon Symbol="Add" />
                <TextBlock Text="添加新映射" />
            </StackPanel>
        </Button>
    </StackPanel>
</ContentDialog>
